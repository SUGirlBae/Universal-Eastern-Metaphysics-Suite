          "type": "object",
          "properties": {
            "datetime_str": {
              "type": "string",
              "description": "DateTime string in DD/MM/YYYY HH:MM format, or empty for NTP atomic now."
            },
            "question": {
              "type": "string",
              "description": "The specific query, decision, or problem the user needs answered."
            },
            "gender": {
              "type": "integer",
              "enum": [
                0,
                1
              ],
              "description": "1 for male, 0 for female. Default is 1."
            },
            "systems": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "iching",
                  "bazi",
                  "tuvi",
                  "halac",
                  "kymon",
                  "timing",
                  "annual",
                  "health",
                  "fengshui"
                ]
              },
              "description": "Filter specific systems to retrieve. Omit to query all."
            },
            "school": {
              "type": "string",
              "enum": [
                "standard",
                "kham_thien",
                "nam_phai",
                "trung_chau",
                "luong_phai",
                "bac_phai",
                "hybrid"
              ],
              "description": "Ziwei school configuration."
            },
            "astrolabe_type": {
              "type": "string",
              "enum": [
                "thien_ban",
                "dia_ban",
                "nhan_ban"
              ],
              "description": "Astrolabe alignment mode."
            },
            "cuc_override": {
              "type": "integer",
              "enum": [
                2,
                3,
                4,
                5,
                6
              ],
              "description": "Custom Cuc number override (2=Thủy, 3=Mộc, 4=Kim, 5=Thổ, 6=Hỏa)."
            }
          },
          "required": [
            "question"
          ]
        }
      }
    },
